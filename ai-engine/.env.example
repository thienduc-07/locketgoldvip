# =========================================================================
# Locket AI Filter Engine - Environment Configuration Template
# =========================================================================

APP_NAME="Locket AI Filter Engine"
APP_ENV="production"
DEBUG=false
PORT=8000
HOST="0.0.0.0"

# Security & Concurrency Limits
MAX_UPLOAD_SIZE_MB=10
MIN_IMAGE_DIMENSION=64
MAX_IMAGE_DIMENSION=4096
MAX_PROCESSING_TIMEOUT_SEC=15.0
MAX_CONCURRENT_TASKS=5
TEMP_DIR="/tmp/ai_engine"

# CORS Configuration (Comma-separated origins, no wildcards with credentials)
CORS_ORIGINS="http://localhost:3000,http://localhost:8000"

# Generative AI Provider (Optional)
# Options: local_cv (default, 100% free), fal_ai
GENERATIVE_PROVIDER="local_cv"

# External GPU Provider Keys (Inject via secure runtime environment only)
FAL_KEY=""
REPLICATE_API_TOKEN=""
HUGGINGFACE_API_KEY=""
