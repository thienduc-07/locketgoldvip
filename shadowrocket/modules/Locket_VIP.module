#!name=Locket VIP
#!desc=Mở khóa Locket Gold trọn đời + Quay video 60s có tiếng + AI Filter Photobooth + Caption tiếng Việt VIP + Chặn QC & Chẩn Đoán Audio. By thienduc-07
#!category=thienduc-07 VIP

[Rule]
# Chặn QUIC/UDP trên các domain Locket để ép dùng TCP/HTTP2 cho MITM giải mã ổn định 100%
AND,((DOMAIN,firebaseremoteconfig.googleapis.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,api.revenuecat.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,api.locketcamera.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,locketcamera.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,cloudfunctions.net),(PROTOCOL,UDP)),REJECT
DOMAIN-SUFFIX,sentry.io,REJECT
DOMAIN-SUFFIX,ingest.sentry.io,REJECT

[Header Rewrite]
# Xóa Cache / ETag trên RevenueCat
^https?:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers) header-del x-revenuecat-etag
^https?:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers) header-del X-RevenueCat-ETag
^https?:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers) header-del if-none-match
^https?:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers) header-del If-None-Match
^https?:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers) header-del if-modified-since
^https?:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers) header-del If-Modified-Since

# Xóa Cache / ETag trên Firebase Remote Config
^https?:\/\/firebaseremoteconfig\.googleapis\.com\/.+ header-del if-none-match
^https?:\/\/firebaseremoteconfig\.googleapis\.com\/.+ header-del If-None-Match
^https?:\/\/firebaseremoteconfig\.googleapis\.com\/.+ header-del if-modified-since
^https?:\/\/firebaseremoteconfig\.googleapis\.com\/.+ header-del If-Modified-Since
^https?:\/\/firebaseremoteconfig\.googleapis\.com\/.+ header-del x-goog-if-none-match

# Xóa Cache / ETag trên Locket Camera API
^https?:\/\/api\.locketcamera\.com\/.+ header-del if-none-match
^https?:\/\/api\.locketcamera\.com\/.+ header-del If-None-Match
^https?:\/\/api\.locketcamera\.com\/.+ header-del if-modified-since
^https?:\/\/api\.locketcamera\.com\/.+ header-del If-Modified-Since

[Script]
# --- 1. REVENUECAT: Mở khóa Locket Gold trọn đời ---
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/thienduc-07/locketgoldvip/main/shadowrocket/js/locket_revenuecat_response.js?v=3.8, requires-body=true, max-size=2097152, timeout=60
deleteHeader_RC = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/thienduc-07/locketgoldvip/main/shadowrocket/js/locket_revenuecat_request.js?v=3.8, timeout=60

# --- 2. FIREBASE: Mở khóa 60s Video có tiếng, Khung Widget & Caption VIP, Chặn QC ---
deleteHeader_Firebase = type=http-request, pattern=^https?:\/\/firebaseremoteconfig\.googleapis\.com\/.+, script-path=https://raw.githubusercontent.com/thienduc-07/locketgoldvip/main/shadowrocket/js/locket_firebase_request.js?v=3.8, timeout=60
locket_rc = type=http-response, pattern=^https?:\/\/firebaseremoteconfig\.googleapis\.com\/.+, script-path=https://raw.githubusercontent.com/thienduc-07/locketgoldvip/main/shadowrocket/js/locket_firebase_response.js?v=3.8, requires-body=true, max-size=4194304, timeout=60

# --- 3. PHOTOBOOTH & AI FILTER ENGINE (RealTrueHieu & Hakaiz V2): Render AI & Photobooth không lỗi ---
locket_pb_req = type=http-request, pattern=^https?:\/\/.*\/generateFilteredImage.*, script-path=https://raw.githubusercontent.com/thienduc-07/locketgoldvip/main/shadowrocket/js/locket_pb_req.js?v=3.8, requires-body=true, max-size=2097152, timeout=60
locket_pb_res = type=http-response, pattern=^https?:\/\/.*\/generateFilteredImage.*, script-path=https://raw.githubusercontent.com/thienduc-07/locketgoldvip/main/shadowrocket/js/locket_pb_req.js?v=3.8, requires-body=true, max-size=4194304, timeout=60

# --- 4. LOCKET API: Mở khóa huy hiệu Gold chính chủ, bypass paywall ---
locket_api = type=http-response, pattern=^https?:\/\/api\.locketcamera\.com\/.+, script-path=https://raw.githubusercontent.com/thienduc-07/locketgoldvip/main/shadowrocket/js/locket_filter_response.js?v=3.8, requires-body=true, max-size=2097152, timeout=60

# --- 5. AUDIO & VIDEO DIAGNOSTICS: Giám sát luồng tạo moment Locket ---
locket_audio_req = type=http-request, pattern=^https?:\/\/api\.locketcamera\.com\/(createMoment|postMoment|upload|moments), script-path=https://raw.githubusercontent.com/thienduc-07/locketgoldvip/main/shadowrocket/js/locket_audio_diagnostics.js?v=3.8, requires-body=true, max-size=262144, timeout=60

[Host]
firebaseremoteconfigrealtime.googleapis.com = 0.0.0.0

[MITM]
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com, api.locketcamera.com, *.locketcamera.com, *.cloudfunctions.net, us-central1-locket-4252a.cloudfunctions.net, uplocket.io.vn
